        <mxCell id="oXkJiP1gAbPugG8GPlLR-19" value="&amp;nbsp;المشروع يجب ان يتم بنائه على&amp;nbsp;&lt;br&gt;nTier" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">

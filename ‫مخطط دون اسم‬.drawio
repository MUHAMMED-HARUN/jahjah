        <mxCell id="oXkJiP1gAbPugG8GPlLR-16" value="في التعديل لا يمكن تعديل الاسم الى اسم مشغول في نفس مسار الاب" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
